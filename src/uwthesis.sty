%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Commands and options for changing section headings fonts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \setallheadstyle is the simplest way to change options for all headings.
% Otherwise you can copy or tweak individual lines as desired.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*{\headerheadstyle}{}
\newcommand{\setallheadstyle}[1]{%
    \setsecheadstyle{\Large #1}
    \setsubsecheadstyle{\large #1}
    \setsubsubsecheadstyle{\normalsize #1}
    \setparaheadstyle{\normalsize #1}
    \setsubparaheadstyle{\normalsize #1}
    \renewcommand*{\headerheadstyle}{\normalsize}
}

% A solid option is to use sans serif family in bold
% \setallheadstyle{\sffamily\bfseries}
% I quite like also using the small caps shape if available
\setsecheadstyle{\Large\sffamily\bfseries\scshape}
\setsubsecheadstyle{\large\sffamily\bfseries\scshape}
\setsubsubsecheadstyle{\normalsize\sffamily\bfseries\scshape}
\setparaheadstyle{\normalsize\sffamily\bfseries\scshape}
\setsubparaheadstyle{\normalsize\sffamily\bfseries\scshape}
\renewcommand*{\headerheadstyle}{\normalsize}

% This sets the style of the page numbers (called the folio)
\newcommand*{\foliostyle}{\normalfont}

% Commands for section number formatting; also used in headers
\newcommand*{\secnumstyle}{}
\setsecnumformat{\secnumstyle\csname the#1\endcsname\quad}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Commands and options for changing chapter styles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% This section starts by defining a few modified chapter styles. Options for 
% more common modifications are at the end of this section, becuase they have
% to come after the definition and selection of the desired chapter style.
% Uncomment one of the \chapterstyle lines at the end of this section to select
% that style, or comment them all out to use the default LaTeX styling.
% These styles are modified from styles found at the following link:
% https://tug.ctan.org/info/MemoirChapStyles/MemoirChapStyles.pdf
% Feel free to select others (or peruse the memoir class manual for more).
% Use the \chap<name,num,title>font macros to format the various components of 
% the default LaTeX style.
% The other defined styles also use the \chaptitlefont macro, and you can use
% the \uwchap<name,num>font macros to tweak the other components.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% An excellent display Garamond font; good for big things like chap num
\iftutex
    \newfontface\cormorantgaramond{CormorantGaramond}[
        UprightFont    = *-Regular,
        ItalicFont     = *-Italic,
        BoldFont       = *-Bold,
        BoldItalicFont = *-BoldItalic,
        Numbers        = Lining,
        Extension      = .ttf,
    ]
\else
    \def\cormorantgaramond{\fontfamily{CormorantGaramond-LF}\selectfont}
\fi

\newsavebox{\ChpNumBox}
\definecolor{BoxColor}{rgb}{0.0,0.0,0.0}
\newcommand*{\thickhrulefill}{%
    \leavevmode\leaders\hrule height 1pt \hfill \kern 0pt}
\newcommand*{\uwdisplaychaptertitle}[1]{%
    \StrLeft{#1}{1}[\uwtitlefirst]%
    \StrGobbleLeft{#1}{1}[\uwtitlerest]%
    {\HUGE\MakeUppercase{\uwtitlefirst}}\MakeUppercase{\uwtitlerest}%
}
\newcommand*\BuildChpNum[2]{%
    \begin{tabular}[t]{@{}c@{}}
        \makebox[0pt][c]{#1\strut} \\[.5ex]
        \colorbox{BoxColor}{%
            \rule[-8em]{0pt}{0pt}% sets the height of the box
            \makebox[{\ifdim1.2cm<\width\width\else1.2cm\fi}]{%
                \color{white}\uwchapnumfont\ #2\ \strut%
        }}%
    \end{tabular}}
\makechapterstyle{ColorBox}{%
    \setlength{\beforechapskip}{20pt}
    \setlength{\midchapskip}{45pt}
    \setlength{\afterchapskip}{40pt}
    \renewcommand{\printchaptername}{}
    \renewcommand{\chapternamenum}{}
    \renewcommand{\printchapternum}{%
        \sbox{\ChpNumBox}{%
            \BuildChpNum{\Large\scshape\uwchapnamefont\@chapapp}%
            {\thechapter}}}
    \renewcommand{\printchapternonum}{%
        \sbox{\ChpNumBox}{%
            \BuildChpNum{\Large\scshape\uwchapnamefont\vphantom{\@chapapp}}%
            {\hphantom{\thechapter}}}}
    \renewcommand{\afterchapternum}{}
    \renewcommand{\printchaptertitle}[1]{%
        \usebox{\ChpNumBox}\hfill
        \parbox[t]{\hsize-\wd\ChpNumBox-1em}{%
            \vspace{\midchapskip}%
            \thickhrulefill\par% Rule only to end of textblock
            % \rule{\paperwidth}{1pt}% Rule out to the edge of page
            \chaptitlefont\vspace{-1ex} ##1\par}}%
}

\newif\ifNoChapNumber
\newcommand{\Vlines}{%
    \def\VL{\rule[-2cm]{1pt}{5cm}\hspace{1mm}\relax}
    \VL\VL\VL\VL\VL\VL\VL}
\setlength\midchapskip{0pt}
\makechapterstyle{VZ43}{
    \renewcommand{\chapternamenum}{}
    \renewcommand{\printchaptername}{}
    \renewcommand{\printchapternum}{}
    \renewcommand{\printchaptertitle}[1]{%
        \Vlines\hspace*{-2em}%
        \begin{tabular}{@{}p{1cm} p{\textwidth-3cm}}%
            \ifNoChapNumber\relax\else%
                \colorbox{black}{\color{white}%
                \makebox[1cm]{\uwchapnumfont\strut\thechapter}}%
            \fi%
            & \chaptitlefont ##1%
        \end{tabular}%
        \NoChapNumberfalse}
    \renewcommand{\printchapternonum}{\NoChapNumbertrue}
}

\definecolor{chapnumcolor}{gray}{0.8}
\newcommand{\numlifter}[1]{{%
    \leavevmode\hansennumfont\uwchapnumfont\strut%
    \raisebox{-\chaptertitleboxheight}[0pt][0pt]{\smash{#1}}\kern37pt%
}}
\newlength\chaptertitleboxheight
\makechapterstyle{hansen}{
    \renewcommand{\printchaptername}{\raggedleft}
    \renewcommand{\printchapternum}{\numlifter{\thechapter}}
    \renewcommand*{\printchapternonum}{\numlifter{}\afterchapternum}
    \setlength\midchapskip{0pt}
    \setlength\beforechapskip{0.5\baselineskip}
    \setlength{\afterchapskip}{3\baselineskip}
    \settototalheight\chaptertitleboxheight{%
        \parbox{\textwidth}{\raggedleft\chaptitlefont bg\\bg\strut}%
    }
    \renewcommand{\printchaptertitle}[1]{%
        \parbox[t][\chaptertitleboxheight][t]{\textwidth}{%
            \microtypesetup{protrusion=false}% add this if you use microtype
            \raggedleft\chaptitlefont ##1\strut}%
    }
    \newcommand{\hansennumfont}{%
        \fontsize{2\chaptertitleboxheight}{0cm}\cormorantgaramond\bfseries\color{chapnumcolor}%
    }
}

\newcommand*{\printhangnum}[1]{%
    \noindent\llap{%
        \colorbox{black}{%
            \makebox[\chapindent][r]{%
                \color{white}\uwchapnumfont%
                % \strut#1\space% Rule vertically centred
                \rule[-0.25ex]{0pt}{3.25ex}#1\kern 0.05em% Rule shifted up
        }}
        \rule{0.25em}{0pt}}}
\makechapterstyle{hangnumruled}{%
    \setlength{\chapindent}{\dimexpr\oddsidemargin+1in\relax}
    \renewcommand*{\printchaptername}{}
    \renewcommand*{\chapternamenum}{}
    \renewcommand*{\printchapternum}{\printhangnum{\thechapter}}
    \renewcommand*{\printchapternonum}{\printhangnum{\relax}}
    \renewcommand*{\afterchapternum}{}
}


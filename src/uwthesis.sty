%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Commands for creating frontmatter chapters and abbreviations page
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*{\frontchapter}[1]{%
    \chapter{#1}
    \markboth{#1}{#1}
}
\NewTblrTheme{abbreviations}{%
    \DefTblrTemplate{contfoot}{default}{}
    \DefTblrTemplate{conthead}{default}{}
    \DefTblrTemplate{capcont}{default}{}
}

\acsetup{%
    make-links,%
    use-id-as-short,%
    list/name=List of abbreviations,%
    list/heading=uwthesis,%
    list/template=uwthesis,%
    % list/display=all,%
}

\NewAcroTemplate[heading]{uwthesis}{\frontchapter{\acrolistname}}
\NewAcroTemplate[list]{uwthesis}{%
    \AcroNeedPackage{tabularray}
    \acronymsmapF{%
        \AcroAddRow{%
            \acrowrite{short}
            \acroifT{alt}{/}\acrowrite{alt}
            &
            \acrowrite{list}
            \acroifanyT{foreign,extra}{~(}
            \acrowrite{foreign}
            \acroifallT{foreign,extra}{,~}
            \acrowrite{extra}
            \acroifanyT{foreign,extra}{)}
            \acropagefill
            \acropages
                { \acrotranslate{page} \nobreakspace }
                { \acrotranslate{pages} \nobreakspace }
            \strut \\
        }
    }
    { \AcroRerun }
    \acroheading
    \acropreamble
    \par\noindent
    \begin{longtblr}[entry=none,label=none,theme=abbreviations,expand=\AcronymTable]
        {stretch=1.2,colspec={@{}>{\bfseries}lX[l]@{}}}
        \AcronymTable
    \end{longtblr}
}



\begingroup % local changes to layout and font should revert after end of group
\setlength{\topmargin}{1.27cm+\trimtop-\headsep-\headheight-1in-\voffset-\topskip}
\setlength{\oddsidemargin}{1.25cm+\stockwidth-\trimedge-\paperwidth-1in-\hoffset}
\setlength{\evensidemargin}{1.5cm+\trimedge-1in}

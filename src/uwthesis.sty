%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Command to insert Warwick keyline letterhead
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Takes two optional arguments, the first specifies margin from top of page,
% while the second specifies the image file to be inserted.
% Default margin is 1.25cm, becuase that is what the brand template uses.
% Defualt artwork is "with", meaning it includes "The University of Warwick".
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NewDocumentCommand\insertkeyline{O{1.25cm}O{crests/keyline_grey_with}}{%
\vspace*{#1-1in-\voffset-\topmargin-\headheight-\headsep-\trimtop-\topskip}%
\hspace*{-\oddsidemargin-1in-\parindent}\makebox[\paperwidth]{%
\includegraphics[width=\paperwidth]{#2}}
}

